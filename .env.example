# DocuMind configuration - copy to .env and adjust. Every value is optional.

# ---- LLM for answer generation (optional) ----
# Without any key the system answers with neural extractive QA (cross-encoder sentence selection).
# "auto" uses the first configured provider: groq -> gemini -> anthropic.
LLM_PROVIDER=auto
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Server ----
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# ---- Models & retrieval ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_OCR=true
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=5
ABSTAIN_THRESHOLD=0.05

# ---- Storage & auth ----
DATA_DIR=data
MAX_FILE_SIZE_MB=25
SESSION_TTL_HOURS=168
DEMO_USERNAME=demo
# Passwords of the accounts created automatically (at least 8 characters). Leave them empty to have random
# ones generated on first start and written to data/initial_credentials.txt (private, never committed).
ADMIN_PASSWORD=
DEMO_PASSWORD=
SEED_USER_PASSWORD=
# Brute-force protection: an account is locked for LOGIN_LOCKOUT_MINUTES after LOGIN_MAX_FAILURES wrong passwords
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
